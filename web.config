<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================================
    Negah Brochure Platform — IIS configuration (project-root deployment)
    ============================================================================
    Use this file when the IIS site's "Physical Path" points at the PROJECT
    ROOT (the folder that contains artisan, app, public, ...).

    Requirements:
      * IIS URL Rewrite Module 2.0  (https://www.iis.net/downloads/microsoft/url-rewrite)
      * PHP 8.2+ registered with IIS as a FastCGI handler for *.php
        (php-cgi.exe), e.g. via "PHP Manager for IIS" or:
        %windir%\system32\inetsrv\appcmd set config /section:system.webServer/fastCGI ^
            /+[fullPath='C:\PHP\php-cgi.exe']
        %windir%\system32\inetsrv\appcmd set config /section:system.webServer/handlers ^
            /+[name='PHP_via_FastCGI',path='*.php',verb='*',modules='FastCgiModule',^
            scriptProcessor='C:\PHP\php-cgi.exe',resourceType='Either',requireAccess='Script']

    NOTE: If you can point the IIS site's Physical Path at the "public"
    sub-folder instead (the recommended setup), delete this file and use
    public\web.config only.
    ============================================================================
-->
<configuration>
    <system.webServer>

        <!-- Never let IIS serve config / VCS / IDE files. -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".git" />
                    <add segment=".github" />
                    <add segment=".vscode" />
                    <add segment=".idea" />
                </hiddenSegments>
                <!-- Block sensitive source/config files at the project root. -->
                <denyUrlSequences>
                    <add sequence="/artisan" />
                    <add sequence="/composer.json" />
                    <add sequence="/composer.lock" />
                    <add sequence="/package.json" />
                    <add sequence="/package-lock.json" />
                    <add sequence="/phpunit.xml" />
                    <add sequence="/vite.config.js" />
                    <add sequence="/tailwind.config.js" />
                    <add sequence="/.env" />
                </denyUrlSequences>
            </requestFiltering>
        </security>

        <rewrite>
            <rules>
                <!--
                    Rule 1: serve real static files that live under "public\"
                    (css, js, build assets, storage\logos uploads, favicon, ...).
                    Example: /storage/logos/logo.png -> public\storage\logos\logo.png
                -->
                <rule name="Negah: static files from public" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="public/{R:1}" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="public/{R:1}" />
                </rule>

                <!--
                    Rule 2: hard-block direct HTTP access to private source and
                    framework folders at the project root (Laravel handles the
                    public URL space; these physical folders must never leak).
                -->
                <rule name="Negah: block sensitive folders" stopProcessing="true">
                    <match url="^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>

                <!--
                    Rule 3: front controller — every other request is handled
                    by Laravel (public/index.php), preserving the original URL
                    and query string so routes like /B/{slug} resolve cleanly.
                -->
                <rule name="Negah: Laravel front controller" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="public/index.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>

        <!-- Sensible static-file caching; PHP is handled by the FastCGI handler. -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>

        <httpErrors errorMode="DetailedLocalOnly" />
    </system.webServer>
</configuration>
